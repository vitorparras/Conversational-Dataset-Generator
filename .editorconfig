# With every style rule at error, the preference decides what the build accepts.
csharp_style_namespace_declarations = file_scoped
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_constructors = false
csharp_style_expression_bodied_operators = when_on_single_line
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_indexers = true
csharp_style_expression_bodied_accessors = true
csharp_style_expression_bodied_lambdas = true
csharp_style_expression_bodied_local_functions = when_on_single_line
# Only S1312 (error) forces the primary constructor, and only for a logger; this preference does not force it on other classes.
csharp_style_prefer_primary_constructors = false
csharp_style_prefer_top_level_statements = true
csharp_prefer_braces = true
dotnet_style_prefer_conditional_expression_over_assignment = false
dotnet_style_prefer_conditional_expression_over_return = false
csharp_style_unused_value_expression_statement_preference = discard_variable
csharp_style_unused_value_assignment_preference = discard_variable

# The host and the test projects are executables without a synchronization context.
dotnet_code_quality.CA2007.output_kind = DynamicallyLinkedLibrary

# A banned symbol (core/BannedSymbols.txt) fails the build on its own, whatever the warning policy.
dotnet_diagnostic.RS0030.severity = error

# The database fixtures are a library of test code, loaded by test executables, which have no synchronization context.
[core/tests/Core.Tests.Database/**.cs]
dotnet_diagnostic.CA2007.severity = none

[core/src/Core.Platform/Logging/LineConsoleFormatter.cs]
# The log line is read by machines; ISO 8601 with a fixed format and the invariant culture is the contract.
dotnet_diagnostic.S6585.severity = none

[core/src/Core.Host/CompositionRoot.cs]
# The composition root depends on every service by definition, and rule 3 makes it the only place that builds them.
dotnet_diagnostic.S1200.severity = none

[core/src/Core.Host/HostLaunch.cs]
# The one place that turns whatever stops the host into ExitCode.ServingFailed, so it catches every exception.
dotnet_diagnostic.S2221.severity = none

[core/src/Core.Persistence/Migrations/StepCommand.cs]
# The text of a step comes from a resource embedded in the artifact and checked by SHA-256, never from input.
dotnet_diagnostic.CA2100.severity = none

[core/src/Core.Persistence/Content/ContentTransaction.cs]
# The statement is written by the code that exposes a query over content, as a constant of its own; it never carries input, and the domain goes by parameter.
dotnet_diagnostic.CA2100.severity = none

[core/src/Core.Persistence/Custody/CustodyScope.cs]
# The statement is the constant of CustodyStatements or the one a person statement declares, the system's own; it never carries input.
dotnet_diagnostic.CA2100.severity = none

[core/tests/Core.Persistence.Content.Tests/Content/ContentDomainTests.cs]
# The statements are the constants of ContentQueries, the system's own, and run here without a domain on purpose.
dotnet_diagnostic.CA2100.severity = none

[*.py]
indent_size = 4

[*.md]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2
