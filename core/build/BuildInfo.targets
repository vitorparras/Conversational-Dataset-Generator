<Project>
  <!--
    Writes the version and what git answered into BuildInfo.g.cs before compiling (issue 51).
    The target only records: the exit code of each git command, the commit when git succeeded,
    and the length of the status output. BuildInfo reads them as clean, dirty or absent, in C#,
    where a test holds the reading. Two things never reach the artifact: the status output, which
    lists file names (untracked ones included), and git's error text, which may carry a path.
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BuildInfoCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_BuildInfoCommitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=normal"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BuildInfoStatus" />
      <Output TaskParameter="ExitCode" PropertyName="_BuildInfoStatusExit" />
    </Exec>

    <PropertyGroup>
      <_BuildInfoCommitOutput Condition="'$(_BuildInfoCommitExit)' == '0'">$(_BuildInfoCommit.Trim())</_BuildInfoCommitOutput>
      <_BuildInfoStatusLength>$(_BuildInfoStatus.Trim().Length)</_BuildInfoStatusLength>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
    </PropertyGroup>

    <ItemGroup>
      <_BuildInfoLine Include="// Generated by core/build/BuildInfo.targets. Do not edit." />
      <_BuildInfoLine Include="namespace Core.Platform.Versioning%3B" />
      <_BuildInfoLine Include="internal static class GeneratedBuildInfo" />
      <_BuildInfoLine Include="{" />
      <_BuildInfoLine Include="    public const string Version = &quot;$(Version)&quot;%3B" />
      <_BuildInfoLine Include="    public const string CommitExitCode = &quot;$(_BuildInfoCommitExit)&quot;%3B" />
      <_BuildInfoLine Include="    public const string CommitOutput = &quot;$(_BuildInfoCommitOutput)&quot;%3B" />
      <_BuildInfoLine Include="    public const string StatusExitCode = &quot;$(_BuildInfoStatusExit)&quot;%3B" />
      <_BuildInfoLine Include="    public const string StatusOutputLength = &quot;$(_BuildInfoStatusLength)&quot;%3B" />
      <_BuildInfoLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
      <FileWrites Include="$(_BuildInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
