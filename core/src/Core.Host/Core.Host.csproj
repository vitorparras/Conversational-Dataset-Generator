<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The screens validate nothing in the browser (decision 0052): no validation attribute is written into the build. -->
    <GenerateEmbeddedValidatableTypeAttribute>false</GenerateEmbeddedValidatableTypeAttribute>
  </PropertyGroup>

  <!--
    Published for a target, the executable carries the runtime and every native library inside one file; beside it
    goes only the settings file. The IIS configuration and the static web assets manifest serve nothing here.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- The code Razor generates for the screens names each component by its absolute path, and the PDB embeds it: no PDB, or no reproducible build (decision 0052). -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Boundary\Core.Boundary.csproj" />
    <ProjectReference Include="..\Core.Persistence\Core.Persistence.csproj" />
    <ProjectReference Include="..\Core.Platform\Core.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Screens/tokens.css" LogicalName="Screens/tokens.css" />
    <EmbeddedResource Include="Screens/screens.css" LogicalName="Screens/screens.css" />
  </ItemGroup>

  <!-- Only the executable says where it came from; the libraries it carries do not run git on every build. -->
  <Import Project="..\..\build\BuildInfo.targets" />

  <ItemGroup>
    <InternalsVisibleTo Include="Core.Host.Tests" />
    <InternalsVisibleTo Include="Core.Host.Tests.Browser" />
  </ItemGroup>
</Project>
