<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    Published for a target, the executable carries the runtime and every native library inside one file; beside it
    goes only the settings file. The IIS configuration and the static web assets manifest serve nothing here.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Boundary\Core.Boundary.csproj" />
    <ProjectReference Include="..\Core.Persistence\Core.Persistence.csproj" />
    <ProjectReference Include="..\Core.Platform\Core.Platform.csproj" />
  </ItemGroup>

  <!-- Only the executable says where it came from; the libraries it carries do not run git on every build. -->
  <Import Project="..\..\build\BuildInfo.targets" />

  <ItemGroup>
    <InternalsVisibleTo Include="Core.Host.Tests" />
  </ItemGroup>
</Project>
