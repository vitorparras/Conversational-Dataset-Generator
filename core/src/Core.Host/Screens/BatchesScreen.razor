@using System.Globalization
@using Core.Persistence.Ingestion

<h1>@Title</h1>
<p class="lead">
    Os lotes dos domínios que você alcança, do mais novo ao mais antigo, cada um com o domínio, o estado, o motivo de uma recusa e o recibo do envio.
    A lista traz todos os domínios que você alcança, qualquer que seja o domínio de trabalho escolhido no cabeçalho. Nenhum texto do material aparece aqui.
</p>

@if (!Granted)
{
    <Panel Id="lotes" Title="Lista de lotes">
        <EmptyState Title="Nenhum lote para mostrar."><p>Você não tem concessão em nenhum domínio. Quem administra o sistema é quem concede.</p></EmptyState>
    </Panel>
}
else
{
    <details id="filtro" class="panel filter-box" open="@Filtered">
        <summary class="filter-box__summary">Filtrar por estado e período@(Filtered ? " (filtro em uso)" : null)</summary>
        <form class="filter" method="get">
            <ChoiceGroup Name="@StateKey" Legend="Estado" Options="StateChoices" Value="@(State ?? string.Empty)" Inline="true" />
            <Field Id="filtro-de" Name="@FromKey" Caption="Enviados a partir de" Type="date" Value="@From" Error="@FromError" />
            <Field Id="filtro-ate" Name="@UntilKey" Caption="Enviados até" Type="date" Value="@Until" Error="@UntilError" />
            <div class="actions">
                <Button Id="filtrar" Kind="Button.Look.Secondary">Filtrar</Button>
                <Button Href="?" Kind="Button.Look.Quiet">Limpar filtro</Button>
            </div>
        </form>
    </details>

    <Panel Id="lotes" Title="Lista de lotes">
        @if (Rows.Count == 0)
        {
            <EmptyState Title="Nenhum lote com esse filtro."><p>Mude ou limpe o filtro para ver os outros.</p></EmptyState>
        }
        else
        {
            <DataTable Id="lotes-tabela" Caption="Um lote por linha, do mais novo ao mais antigo. Horários em UTC." Headers="Columns" Stacks="true">
                <tbody role="rowgroup">
                    @foreach (var row in Rows)
                    {
                        <tr role="row">
                            <th scope="row" role="rowheader">Lote&nbsp;@row.Id.ToString(CultureInfo.InvariantCulture)</th>
                            <td role="cell">@row.Domain</td>
                            <td role="cell">
                                <StateMark Kind="BatchTexts.ToneOf(row.State)">@BatchTexts.StateOf(row.State)</StateMark>
                                @if (row.Motive is { } motive)
                                {
                                    <p>@BatchTexts.MotiveOf(motive)</p>
                                }
                            </td>
                            <td role="cell">@row.SubmittedBy</td>
                            <td role="cell"><Moment At="row.SubmittedAt" /></td>
                            <td role="cell">
                                @if (row.Receipt is { } receipt)
                                {
                                    <p>@BatchTexts.SizeOf(receipt.Bytes)</p>
                                    <details class="digest-box">
                                        <summary>Resumo (SHA-256): <code class="digest" aria-hidden="true">@receipt.Digest</code> mostrar inteiro</summary>
                                        <code class="digest-box__full">@receipt.Digest</code>
                                    </details>
                                    @if (receipt.Warning is { } warning)
                                    {
                                        <p>@BatchTexts.WarningOf(warning)</p>
                                    }
                                }
                                else
                                {
                                    @NoReceipt
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>
        }
        <PageSteps Caption="Páginas de lotes" Page="Page" HasNext="HasNext" PageSize="Size" Address="Address" />
    </Panel>
}

@code {
    /// <summary>The title of the page and of its entry in the menu.</summary>
    internal const string Title = "Lotes";

    /// <summary>The keys of the filter and of the page in the address, which keeps both so that going back and sharing work (decision 0051).</summary>
    internal const string StateKey = "estado";

    internal const string FromKey = "de";

    internal const string UntilKey = "ate";

    internal const string PageKey = "pagina";

    /// <summary>How many batches a page holds.</summary>
    internal const int Size = 20;

    /// <summary>Whether a filter is in use, or refused; the box of the filter then opens by itself, and folds otherwise so the list comes first.</summary>
    private bool Filtered => new[] { State, From, Until, FromError, UntilError }.Any(value => !string.IsNullOrEmpty(value));

    private const string NoReceipt = "Sem envio registrado";

    private const string NotADay = "Escreva a data como dia, mês e ano; ela ficou de fora do filtro.";

    private static readonly string[] Columns = { "Lote", "Domínio", "Estado", "Enviado por", "Quando", "Recibo do envio" };

    private static readonly ChoiceGroup.Option[] StateChoices =
    {
        new("", "Todos"), new("em-curso", "Em curso"), new("aceitos", "Aceitos"), new("rejeitados", "Rejeitados"),
    };

    /// <summary>One batch as the list shows it: the domain and the person who submitted by name, and nothing of the material.</summary>
    public sealed record Row(long Id, string Domain, BatchState State, string? Motive, string SubmittedBy, DateTimeOffset SubmittedAt, Receipt? Receipt);

    /// <summary>What the submission brought: how many bytes, their SHA-256 and the code of a warning, if one was recorded; never the name of the file.</summary>
    public sealed record Receipt(long Bytes, string Digest, string? Warning);

    /// <summary>The batches of this page alone, cut by the server.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Row> Rows { get; set; } = Array.Empty<Row>();

    /// <summary>Whether a domain is granted at all; with none, the list is empty and says why, with no filter and no pages, and never an error.</summary>
    [Parameter]
    public bool Granted { get; set; }

    /// <summary>The filter as it is in the address, given back to its fields.</summary>
    [Parameter]
    public string? State { get; set; }

    [Parameter]
    public string? From { get; set; }

    [Parameter]
    public string? Until { get; set; }

    /// <summary>What the server left out of the period, each bound to its field.</summary>
    [Parameter]
    public string? FromError { get; set; }

    [Parameter]
    public string? UntilError { get; set; }

    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public bool HasNext { get; set; }

    /// <summary>The state the address asks for; none for any, or for a value the screen does not offer.</summary>
    internal static BatchState? StateOf(string? key) => key switch
    {
        "em-curso" => BatchState.Open,
        "aceitos" => BatchState.Accepted,
        "rejeitados" => BatchState.Rejected,
        _ => null,
    };

    /// <summary>
    /// The period the address asks for, by the day in universal time: from the start of the first day to the end of the last, both counted. A day that is not a date is left
    /// out and says so at its field; a last day before the first leaves both out and says why at the field of the last.
    /// </summary>
    internal static (DateTimeOffset? From, DateTimeOffset? Until, string? FromError, string? UntilError) PeriodOf(string? from, string? until)
    {
        var (first, last) = (DayOf(from), DayOf(until));
        var (fromError, untilError) = (Refused(from, first), Refused(until, last));
        return first is { } start && last is { } end && end < start
            ? (null, null, null, "A data final vem antes da inicial; o período ficou de fora.")
            : (first, last?.AddDays(1), fromError, untilError);
    }

    private static string? Refused(string? typed, DateTimeOffset? day) => string.IsNullOrEmpty(typed) || day is not null ? null : NotADay;

    private static DateTimeOffset? DayOf(string? typed) =>
        DateOnly.TryParseExact(typed, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) ? new DateTimeOffset(day, TimeOnly.MinValue, TimeSpan.Zero) : null;

    /// <summary>The address of a page with the filter in force, leaving out what is not filtered.</summary>
    private string Address(int page)
    {
        var keys = new Dictionary<string, string?>(StringComparer.Ordinal) { [StateKey] = State, [FromKey] = From, [UntilKey] = Until };
        keys[PageKey] = page.ToString(CultureInfo.InvariantCulture);
        return QueryString.Create(keys.Where(pair => !string.IsNullOrEmpty(pair.Value))).ToUriComponent();
    }
}
