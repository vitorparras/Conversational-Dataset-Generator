@using Core.Platform.Configuration

<h1>@Title</h1>
<p class="lead">Os valores com que o sistema está rodando agora e de onde veio cada um.</p>

<Panel Id="chaves" Title="Chaves em vigor">
    <Notice>Esta tela só mostra. Quem administra o servidor altera os valores; o novo vale quando o sistema reinicia.</Notice>
    <details class="filter-box">
        <summary class="filter-box__summary">Como se altera um valor</summary>
        <p>
            O valor se grava no arquivo de configuração, numa variável de ambiente ou num argumento da linha de comando, nessa ordem de precedência crescente.
            De uma chave de segredo aparecem só o nome e a origem.
        </p>
    </details>
    <DataTable Id="chaves-tabela" Caption="@($"{Entries.Count} chaves, uma por linha, agrupadas por seção.")" Headers="Columns">
        @foreach (var section in Entries.GroupBy(entry => entry.Key.Split(':')[0]))
        {
            <tbody role="rowgroup">
                <tr role="row"><th role="rowheader" class="data-table__group" colspan="@Columns.Length" scope="rowgroup">@SectionTitle(section.Key)</th></tr>
                @foreach (var entry in section)
                {
                    <tr role="row">
                        <th scope="row" role="rowheader"><code>@entry.Key</code></th>
                        <td role="cell">
                            @Value(entry.Value)
                            @if (entry.Mark is { } mark)
                            {
                                <span class="data-table__mark"><StateMark>@mark</StateMark></span>
                            }
                        </td>
                        <td role="cell">@Origin(entry.Origin)</td>
                        <td role="cell">No servidor</td>
                    </tr>
                }
            </tbody>
        }
    </DataTable>
</Panel>

@code {
    /// <summary>The title of the page and of its entry in the menu.</summary>
    internal const string Title = "Configuração em vigor";

    private static readonly string[] Columns = { "Chave", "Valor", "Origem", "Onde se altera" };

    /// <summary>Every key in force, as the route of the configuration returns it: a secret already redacted, so its value never reaches the page.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<EffectiveEntry> Entries { get; set; } = Array.Empty<EffectiveEntry>();

    /// <summary>The name of a section in words, with the name in the file beside it; every section the host declares has one, which a test walks.</summary>
    internal static string SectionTitle(string key) => key switch
    {
        "Host" => "Servidor (Host)",
        "Session" => "Sessões (Session)",
        "Custody" => "Guarda da chave e selo (Custody)",
        "Passwords" => "Senhas (Passwords)",
        "Installation" => "Instalação (Installation)",
        "Database" => "Banco de dados (Database)",
        "Ingestion" => "Ingestão (Ingestion)",
        "Audit" => "Auditoria (Audit)",
        "MasterKey" => "Chave mestra (MasterKey)",
        "Recognizer" => "Reconhecedor (Recognizer)",
        "LanguageService" => "Serviço de linguagem (LanguageService)",
        "Tls" => "Certificado e chave de TLS (Tls)",
        "Mail" => "Envio de e-mail (Mail)",
        _ => key,
    };

    private static RenderFragment Value(string? value) => value switch
    {
        null => @<StateMark>Sem valor</StateMark>,
        _ when value == EffectiveConfiguration.Redacted => @<StateMark Kind="StateMark.Tone.Hidden">Segredo, valor oculto</StateMark>,
        _ => @<code>@value</code>,
    };

    private static string Origin(ConfigurationOrigin origin) => origin switch
    {
        ConfigurationOrigin.File => "Arquivo de configuração",
        ConfigurationOrigin.Environment => "Variável de ambiente",
        ConfigurationOrigin.Argument => "Argumento da linha de comando",
        _ => "Padrão do sistema",
    };
}
