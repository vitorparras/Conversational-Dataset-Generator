<div class="@Classes" role="region" aria-labelledby="@CaptionId" tabindex="0" style="@HeaderProperties">
    <table>
        <caption id="@CaptionId">@Caption</caption>
        <thead><tr>@foreach (var header in Headers) { <th scope="col">@header</th> }</tr></thead>
        @ChildContent
    </table>
</div>

@code {
    /// <summary>The identifier of the table, which names its caption and so the region a reader of screens lands on and the keyboard scrolls when the screen is narrow.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    /// <summary>What one row of the table is, said before the rows.</summary>
    [Parameter, EditorRequired]
    public string Caption { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Headers { get; set; } = Array.Empty<string>();

    /// <summary>The bodies of the table, each a <c>tbody</c> whose rows start with the header of the row.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether, in a box narrower than the columns need, each row becomes a block with each cell under the header of its column, instead of the table scrolling sideways:
    /// for a table of a few columns whose last one holds what to do, so that it is never out of sight. Up to six columns.
    /// </summary>
    [Parameter]
    public bool Stacks { get; set; }

    private string CaptionId => $"{Id}-legenda";

    private string Classes => Stacks ? "data-table data-table--stacks" : "data-table";

    /// <summary>The headers as the custom properties the style writes over each cell of a stacked row; nothing when the table does not stack.</summary>
    private string? HeaderProperties => Stacks ? string.Join(' ', Headers.Select((header, column) => $"--data-table-header-{column + 1}: \"{Quoted(header)}\";")) : null;

    private static string Quoted(string header) => header.Replace("\\", "\\\\", StringComparison.Ordinal).Replace("\"", "\\\"", StringComparison.Ordinal);
}
