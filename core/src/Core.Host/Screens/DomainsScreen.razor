@using Core.Persistence.Domains

<h1>@Title</h1>
@if (WritesSuspended)
{
    <Notice>A escrita está suspensa nos domínios: a última verificação da cadeia de custódia não conferiu. A leitura continua. Quem administra o servidor vê o estado na tela da custódia.</Notice>
}
<p class="lead">
    Os domínios desta instalação e quando cada um foi criado. O sistema ainda não guarda a versão da taxonomia nem a das dimensões
    de um domínio, por isso toda linha diz “Nenhuma carregada”.
</p>
@if (Domains.Count == 0)
{
    <EmptyState Title="Nenhum domínio">
        <p>Esta instalação ainda não tem domínio. Quem administra o servidor cria o primeiro com o comando <code>create-domain</code>.</p>
    </EmptyState>
}
else
{
    <Panel Id="dominios" Title="Domínios carregados">
        <DataTable Id="dominios-tabela" Caption="@(Domains.Count == 1 ? "Um domínio." : $"{Domains.Count} domínios, na ordem em que foram criados.")" Headers="Columns">
            <tbody role="rowgroup">
                @foreach (var domain in Domains)
                {
                    <tr role="row">
                        <th scope="row" role="rowheader">@domain.Name</th>
                        <td role="cell"><Moment At="domain.CreatedAt" /></td>
                        <td role="cell">@Version(domain.TaxonomyVersion)</td>
                        <td role="cell">@Version(domain.DimensionsVersion)</td>
                    </tr>
                }
            </tbody>
        </DataTable>
    </Panel>
}

@code {
    /// <summary>The title of the page and of its entry in the menu.</summary>
    internal const string Title = "Domínios";

    private static readonly string[] Columns = { "Domínio", "Criado em", "Versão da taxonomia", "Versão das dimensões" };

    /// <summary>Every domain, as the listing reads it; the model keeps no version of the taxonomy or of the dimensions yet, so both are absent and shown as such, never made up.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ListedDomain> Domains { get; set; } = Array.Empty<ListedDomain>();

    /// <summary>Whether the last verification of the chain failed, so that the domains accept no writing.</summary>
    [Parameter]
    public bool WritesSuspended { get; set; }

    private static RenderFragment Version(string? version) => version is null ? @<StateMark>Nenhuma carregada</StateMark> : @<code>@version</code>;
}
