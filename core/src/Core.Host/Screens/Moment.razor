@using System.Globalization

<time datetime="@At.ToString("O", CultureInfo.InvariantCulture)">@At.ToUniversalTime().ToString(Shown, CultureInfo.InvariantCulture)</time>

@code {
    /// <summary>One way to write an instant on every screen, in universal time and saying so, so that no reader takes it for their own.</summary>
    private const string Shown = "dd/MM/yyyy 'às' HH:mm:ss 'UTC'";

    [Parameter, EditorRequired]
    public DateTimeOffset At { get; set; }
}
