@using Core.Host.Endpoints
@using Core.Persistence.People

<h1>@Title</h1>
<p class="lead">O que o sistema precisa que você saiba. Ao marcar um aviso como lido, ele sai desta lista e continua registrado.</p>
@if (Marked)
{
    <Notice Kind="Notice.Tone.Success">O aviso foi marcado como lido.</Notice>
}
@if (Notices.Count == 0)
{
    <EmptyState Title="Nenhum aviso novo">
        <p>Quando o sistema tiver algo a dizer sobre a sua conta ou sobre os domínios, aparece aqui.</p>
    </EmptyState>
}
else
{
    <Panel Id="avisos" Title="Avisos não lidos">
        <DataTable Id="avisos-tabela" Caption="@(Notices.Count == 1 ? "Um aviso, o mais recente primeiro." : $"{Notices.Count} avisos, o mais recente primeiro.")" Headers="Columns">
            <tbody role="rowgroup">
                @foreach (var notice in Notices)
                {
                    <tr role="row">
                        <th scope="row" role="rowheader" id="aviso-@notice.Id">@NoticeText.Of(notice)</th>
                        <td role="cell"><Moment At="notice.CreatedAt" /></td>
                        <td role="cell">
                            <form method="post" action="@NoticeScreensEndpoint.ReadPath(notice.Id)">
                                <Button Id="@($"lido-{notice.Id}")" Kind="Button.Look.Secondary" DescribedBy="@($"aviso-{notice.Id}")">Marcar como lido</Button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </DataTable>
    </Panel>
}

@code {
    /// <summary>The title of the page.</summary>
    internal const string Title = "Avisos";
    private static readonly string[] Columns = { "Aviso", "Quando", "Ação" };

    /// <summary>The notices of the person that were not read, the newest first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<PersonNotice> Notices { get; set; } = Array.Empty<PersonNotice>();

    /// <summary>Whether a notice was just marked as read, which the redirect after the post tells.</summary>
    [Parameter]
    public bool Marked { get; set; }
}
