@using System.Globalization
@using Core.Host.Endpoints
@using Core.Persistence.People

<h1>@Title</h1>
<p class="lead">Quem opera o sistema, com a função declarada e o estado. Nenhum conteúdo de material aparece aqui.</p>
@if (Registered is not null)
{
    <Notice Kind="Notice.Tone.Success">@Registered foi cadastrada, sem nenhuma concessão de domínio. Ela entra com a senha inicial que você definiu e a troca depois.</Notice>
}
<div class="actions">
    <Button Href="@ScreenPaths.OperatorNew">Cadastrar pessoa</Button>
</div>

<Panel Id="filtro" Title="Filtrar">
    <form class="filter" method="get" action="@ScreenPaths.Operators">
        <Field Id="filtro-nome" Name="@NameKey" Caption="Nome contém" Value="@Name" Autocomplete="off" />
        <Field Id="filtro-funcao" Name="@FunctionKey" Caption="Função" Value="@Function" Options="FunctionChoices" />
        <Field Id="filtro-estado" Name="@StateKey" Caption="Estado" Value="@State" Options="StateChoices" />
        <div class="actions">
            <Button Id="filtrar" Kind="Button.Look.Secondary">Filtrar</Button>
            <Button Href="@ScreenPaths.Operators" Kind="Button.Look.Quiet">Limpar filtro</Button>
        </div>
    </form>
</Panel>

<Panel Id="lista" Title="@(Page.Total == 1 ? "1 pessoa" : $"{Page.Total} pessoas")">
    <PagedList Items="Page.Items" Caption="Pessoas" Page="Page.Page" PageCount="Page.Pages" PageSize="PersonPage.Size" Address="Address"
               EmptyTitle="Nenhuma pessoa com esse filtro." EmptyHint="Mude ou limpe o filtro para ver as outras.">
        <ItemContent>
            <span class="row">
                <strong>@context.Name</strong>
                <span>@context.Function</span>
                @if (context.Active)
                {
                    <StateMark Kind="StateMark.Tone.Good">Ativa</StateMark>
                }
                else
                {
                    <StateMark>Inativa</StateMark>
                }
            </span>
            @if (context.Active)
            {
                <Button Href="@OperatorEmailEndpoint.Of(context.Id)" Kind="Button.Look.Quiet">E-mail de @context.Name</Button>
            }
        </ItemContent>
    </PagedList>
</Panel>

@code {
    /// <summary>The title of the page and of its entry in the menu.</summary>
    internal const string Title = "Pessoas";

    /// <summary>The keys of the filter and of the page in the address, which keeps both so that going back and sharing work (decision 0051).</summary>
    internal const string NameKey = "nome";

    internal const string FunctionKey = "funcao";

    internal const string StateKey = "estado";

    internal const string PageKey = "pagina";

    internal const string ActiveState = "ativas";

    internal const string InactiveState = "inativas";

    private static readonly List<Field.Option> FunctionChoices =
        new(PersonFunctions.Accepted.Select(function => new Field.Option(function, function)).Prepend(new Field.Option("", "Todas as funções")));

    private static readonly Field.Option[] StateChoices = { new Field.Option("", "Todos os estados"), new Field.Option(ActiveState, "Ativas"), new Field.Option(InactiveState, "Inativas") };

    /// <summary>The page the registry answered, already filtered and cut to its fixed size by the server.</summary>
    [Parameter, EditorRequired]
    public PersonPage Page { get; set; } = default!;

    /// <summary>The filter as it is in the address, given back to its fields.</summary>
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Function { get; set; }

    [Parameter]
    public string? State { get; set; }

    /// <summary>The name of the person just registered, which the page says it was; null otherwise.</summary>
    [Parameter]
    public string? Registered { get; set; }

    /// <summary>The address of a page with the filter in force, leaving out what is not filtered.</summary>
    private string Address(int page)
    {
        var keys = new Dictionary<string, string?>(StringComparer.Ordinal) { [NameKey] = Name, [FunctionKey] = Function, [StateKey] = State };
        keys[PageKey] = page.ToString(CultureInfo.InvariantCulture);
        return QueryString.Create(keys.Where(pair => !string.IsNullOrEmpty(pair.Value))).ToUriComponent();
    }
}
