@if (Page > 1 || HasNext)
{
    <nav class="pager" aria-label="@Caption">
        @if (Page > 1)
        {
            <a href="@Address(Page - 1)" rel="prev">Anterior</a>
        }
        <span aria-current="page">Página @Page, @PageSize por página</span>
        @if (HasNext)
        {
            <a href="@Address(Page + 1)" rel="next">Próxima</a>
        }
    </nav>
}

@code {
    /// <summary>
    /// The way between the pages of a list whose total the server does not count: the page in force, and the previous and the next only where there is one, never as dead text.
    /// With a single page there is nowhere to go and nothing is shown.
    /// </summary>
    [Parameter, EditorRequired]
    public string Caption { get; set; } = "";

    [Parameter]
    public int Page { get; set; } = 1;

    /// <summary>Whether the server found a page after this one.</summary>
    [Parameter]
    public bool HasNext { get; set; }

    [Parameter]
    public int PageSize { get; set; }

    /// <summary>The address of a page, which keeps the page and the filter in the address so that going back and sharing work.</summary>
    [Parameter, EditorRequired]
    public Func<int, string> Address { get; set; } = _ => "";
}
