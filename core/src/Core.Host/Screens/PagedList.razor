@typeparam TItem

@if (Items.Count == 0)
{
    <EmptyState Title="@EmptyTitle">
        @if (EmptyHint is not null)
        {
            <p>@EmptyHint</p>
        }
    </EmptyState>
}
else
{
    <ul class="paged-list" aria-label="@Caption">
        @foreach (var item in Items)
        {
            <li>@ItemContent(item)</li>
        }
    </ul>
    @if (PageCount > 1)
    {
        <nav class="pager" aria-label="Páginas de @Caption.ToLowerInvariant()">
            @if (Page > 1)
            {
                <a href="@Address(Page - 1)" rel="prev">Anterior</a>
            }
            <span aria-current="page">Página @Page de @PageCount, @PageSize por página</span>
            @if (Page < PageCount)
            {
                <a href="@Address(Page + 1)" rel="next">Próxima</a>
            }
        </nav>
    }
}

@code {
    /// <summary>The items of this page alone: the server filters and pages (decision 0051), the list only shows.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemContent { get; set; } = _ => _ => { };

    /// <summary>What the list holds, which names it and its pages for a reader of screens.</summary>
    [Parameter, EditorRequired]
    public string Caption { get; set; } = "";

    [Parameter]
    public int Page { get; set; } = 1;

    /// <summary>How many pages the filter leaves: with one there is nowhere to go and no pager is shown, and a way with no page behind it is never shown as dead text.</summary>
    [Parameter]
    public int PageCount { get; set; } = 1;

    /// <summary>The fixed size the screen declares.</summary>
    [Parameter]
    public int PageSize { get; set; }

    /// <summary>The address of a page, which keeps the page and the filter in the address so that going back and sharing work.</summary>
    [Parameter, EditorRequired]
    public Func<int, string> Address { get; set; } = _ => "";

    /// <summary>What the empty list says, and what makes something appear in it.</summary>
    [Parameter, EditorRequired]
    public string EmptyTitle { get; set; } = "";

    [Parameter]
    public string? EmptyHint { get; set; }
}
