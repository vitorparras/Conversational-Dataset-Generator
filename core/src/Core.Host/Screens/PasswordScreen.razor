@using Core.Host.Endpoints
@using Core.Host.Operators

<h1>@Title</h1>
<p>Informe a senha que você usa hoje e a nova. Ao trocar, as suas outras sessões abertas são encerradas; esta continua aberta.</p>
<form class="form" method="post" action="@ScreenPaths.AccountChange" data-wait="senha-espera" novalidate>
    @if (Shown == Problem.NotWritten)
    {
        <Notice Kind="Notice.Tone.Error">A senha não foi trocada. Tente de novo em instantes; se a falha se repetir, avise quem administra o sistema.</Notice>
    }
    <Field Id="@CurrentField" Caption="Senha atual" Type="password" Autocomplete="current-password" Required="true" Autofocus="true"
           Error="@(Shown == Problem.Refused ? PasswordChangeWords.WrongCurrent : null)" />
    <Field Id="@ReplacementField" Caption="Nova senha" Type="password" Autocomplete="new-password" Required="true"
           Hint="O sistema só exige que a senha nova não fique em branco; escolha uma que só você saiba." Error="@(Shown == Problem.EmptyReplacement ? PasswordChangeWords.BlankReplacement : null)" />
    <Field Id="@RepeatField" Caption="Repita a nova senha" Type="password" Autocomplete="new-password" Required="true"
           Error="@(Shown == Problem.Mismatch ? PasswordChangeWords.Mismatch : null)" />
    <p id="senha-espera" class="wait" role="status" data-wait-text="Trocando a senha. A resposta pode levar alguns segundos."></p>
    <div class="actions">
        <Button Id="trocar-senha">Trocar senha</Button>
        <Button Href="@ScreenPaths.Account" Kind="Button.Look.Quiet">Voltar à minha conta</Button>
    </div>
</form>

@code {
    /// <summary>What the page tells after a try: nothing, a refusal (one text for a wrong password and for a wait, so it never tells which), an empty new password or a change not written.</summary>
    public enum Problem
    {
        None,
        Refused,
        EmptyReplacement,
        Mismatch,
        NotWritten,
    }

    internal const string Title = "Trocar senha";

    /// <summary>The fields the form sends; the passwords go in the body of the post alone and are never written back.</summary>
    internal const string CurrentField = "senha-atual";

    internal const string ReplacementField = "senha-nova";

    internal const string RepeatField = "senha-repetida";

    [Parameter]
    public Problem Shown { get; set; }
}
