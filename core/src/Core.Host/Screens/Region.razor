@if (Asked is null || Asked == Id)
{
    <div id="@Id" data-region data-focus="@Focus" tabindex="-1">@ChildContent</div>
}

@code {
    /// <summary>The region the request asked for alone; with none, every region is shown.</summary>
    [CascadingParameter(Name = "RegionAsked")]
    public string? Asked { get; set; }

    /// <summary>The identifier the client layer swaps by.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    /// <summary>The selector, inside the region, of the element that takes the focus once the region is swapped in; the region itself when absent.</summary>
    [Parameter]
    public string? Focus { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
