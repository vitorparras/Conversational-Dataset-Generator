<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title · @ScreenHeader.Name</title>
    <link rel="stylesheet" href="@ScreenAssets.StyleRoute" />
    <script src="@ScreenAssets.ScriptRoute" defer></script>
</head>
<body>
    <a class="skip-link" href="#content">Ir para o conteúdo</a>
    <ScreenHeader WithSession="WithSession" Menu="Menu" Granted="Granted" Current="@Current" />
    <main id="content" class="page" tabindex="-1">
        <CascadingValue Value="this" IsFixed="true">
            <DynamicComponent Type="Screen" Parameters="ScreenParameters" />
        </CascadingValue>
    </main>
</body>
</html>

@code {
    /// <summary>The title of the page, which a reader of screens hears first.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>The screen shown inside the main region of the page.</summary>
    [Parameter, EditorRequired]
    public Type Screen { get; set; } = typeof(object);

    /// <summary>What the screen takes, if anything.</summary>
    [Parameter]
    public IDictionary<string, object?>? ScreenParameters { get; set; }

    /// <summary>Whether the page stands behind a session, which gives the header the action that ends it.</summary>
    [Parameter]
    public bool WithSession { get; set; }

    /// <summary>The screens the one who entered reaches, in the order of the menu; the start page lists the same.</summary>
    [Parameter]
    public IReadOnlyList<ScreenNav.Entry> Menu { get; set; } = Array.Empty<ScreenNav.Entry>();

    /// <summary>The domains granted to the one who entered.</summary>
    [Parameter]
    public IEnumerable<string> Granted { get; set; } = Enumerable.Empty<string>();

    /// <summary>The route of the page, which marks its own entry in the menu.</summary>
    [Parameter]
    public string? Current { get; set; }
}
