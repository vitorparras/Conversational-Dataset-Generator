@using Core.Host.Endpoints

<header class="header">
    <a class="header__name" href="@ScreenPaths.Home">@Name</a>
    @if (Demonstration)
    {
        <p class="header__demo" role="note">Instalação de demonstração: não envie material real.</p>
    }
    @if (Collapses)
    {
        <button id="cabecalho-abrir" class="button button--secondary header__toggle" type="button" aria-expanded="false" aria-controls="cabecalho-menu">Menu@(ToggleNote)</button>
    }
    <div id="cabecalho-menu" class="header__menu">
        <DomainPicker Granted="Granted" />
        @if (Unread > 0)
        {
            <a class="header__notices" href="@ScreenPaths.Notices">@Unread @(Unread == 1 ? "aviso não lido" : "avisos não lidos")</a>
        }
        @if (WithSession)
        {
            <a class="nav__link header__account" href="@ScreenPaths.Account" aria-current="@AccountCurrent">@AccountScreen.Title</a>
            <form class="header__leave" method="post" action="@ScreenPaths.SignOut">
                <Button Id="sair" Kind="Button.Look.Secondary">Sair</Button>
            </form>
        }
        <ScreenNav Entries="Menu" Current="@Current" />
    </div>
</header>

@code {
    /// <summary>The name of the system, the first thing on every page and the way back to the start.</summary>
    internal const string Name = "Gerador de bases conversacionais";

    /// <summary>The screens the one who entered reaches; with none, the header has no menu at all.</summary>
    [Parameter]
    public IReadOnlyList<ScreenNav.Entry> Menu { get; set; } = Array.Empty<ScreenNav.Entry>();

    /// <summary>The domains granted; with none, the header has no selector.</summary>
    [Parameter]
    public IEnumerable<string> Granted { get; set; } = Enumerable.Empty<string>();

    [Parameter]
    public string? Current { get; set; }

    [Parameter]
    public int Unread { get; set; }

    /// <summary>Whether the installation is a demonstration, which the band under the name says.</summary>
    [Parameter]
    public bool Demonstration { get; set; }

    /// <summary>Whether the page stands behind a session, and so offers to end it on the server.</summary>
    [Parameter]
    public bool WithSession { get; set; }

    /// <summary>Whether there is anything past the name, which on a phone folds behind the button of the menu so that the header keeps a line of its own.</summary>
    private bool Collapses => WithSession || Menu.Count > 0 || Granted.Any();

    /// <summary>The notices not read, said on the folded button too, so that a phone sees them without opening the menu.</summary>
    private string? ToggleNote => Unread switch { <= 0 => null, 1 => " (1 não lido)", _ => $" ({Unread} não lidos)" };

    /// <summary>The account is the page itself on its own route and the place the page stands in on its own pages, named one by one so that an address that leads nowhere marks nothing.</summary>
    private string? AccountCurrent => Current switch
    {
        ScreenPaths.Account => "page",
        ScreenPaths.AccountChange or ScreenPaths.AccountEnd or ScreenPaths.AccountEndOthers => "location",
        _ => null,
    };
}
