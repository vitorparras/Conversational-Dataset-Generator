<p id="@Id" class="wait" role="status" data-wait-text="@Text"></p>

@code {
    /// <summary>The identifier the form names in <c>data-wait</c>: the client layer fills this live region while the form is on its way, and it stays empty without script.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    /// <summary>What the wait is and how long it may take.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";
}
