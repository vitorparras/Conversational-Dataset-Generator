<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    The targets the executable is published for. Every project it carries restores for both, so the locked restore of
    a publish for either finds its graph in the lock file; the single-file analyzer fails the build on code that would
    only break inside the bundle.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- Symbols travel inside each assembly and documentation stays out, so nothing but the bundle carries code. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <DebugType>embedded</DebugType>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
</Project>
