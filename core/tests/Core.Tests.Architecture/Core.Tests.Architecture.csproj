<Project Sdk="Microsoft.NET.Sdk">
  <!-- The test host fell inside the runtime's background garbage collector on both systems (issue #375); this host has none. -->
  <PropertyGroup>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- The sonar rule catalog is read from the restored analyzer, whichever version the package list pins. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SonarAnalyzerPath</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)sonaranalyzer.csharp/@(PackageVersion->WithMetadataValue('Identity', 'SonarAnalyzer.CSharp')->'%(Version)')/analyzers/SonarAnalyzer.CSharp.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
