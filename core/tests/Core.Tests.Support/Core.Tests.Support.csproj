<Project Sdk="Microsoft.NET.Sdk">
  <!-- Helpers shared by the test projects: the property runner and the ports that are closed; it holds no test, so it is a library and no test assembly. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <!-- Test code is not measured: the library is no test assembly, so coverage would instrument it and no area of 014 owns it. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>
</Project>
