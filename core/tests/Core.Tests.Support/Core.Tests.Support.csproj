<Project Sdk="Microsoft.NET.Sdk">
  <!-- Support for the test projects that run properties; it holds no test, so it is a library and no test assembly. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
</Project>
