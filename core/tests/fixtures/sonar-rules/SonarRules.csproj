<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built by Core.Platform.Tests, never by the solution: it must fail, and only because of a Sonar rule. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- The style rule flags the same unused member; silenced so the Sonar rules fail alone. -->
    <NoWarn>$(NoWarn);IDE0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <Using Remove="Xunit" />
  </ItemGroup>
</Project>
